+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::domain::{comment::ThreadAnchor, user::User};
+
+    #[test]
+    fn resolved_fold_preserves_content_and_fits_narrow_panes() {
+        let now = Utc::now();
+        let thread = CommentThread {
+            comments: vec![Comment {
+                id: Some(10),
+                author: User {
+                    username: "reviewer-with-a-long-name".into(),
+                },
+                content: "Keep the error context.".into(),
+                created: now,
+                reactions: vec![],
+                reply_to: Some(10),
+            }],
+            reply_to: Some(10),
+            anchor: Some(ThreadAnchor {
+                revision: None,
+                path: "src/main.rs".into(),
+                line: Some(1),
+                old_line: None,
+                resolved: true,
+                node_id: Some("thread-10".into()),
+            }),
+        };
+        for width in [1, 20, 40, 80] {
+            let folded = render_inline_thread(&thread, width, now, true, None, "", false);
+            assert_eq!(folded.len(), 1);
+            assert!(folded[0].width() <= width as usize);
+        }
+        let expanded = render_inline_thread(&thread, 80, now, true, None, "", true);
+        let text = expanded
+            .iter()
+            .map(ToString::to_string)
+            .collect::<Vec<_>>()
+            .join("\n");
+        assert!(text.contains("▾ ✓ resolved · 1 comment"));
+        assert!(text.contains("Keep the error context."));
+        let folded = render_inline_thread(&thread, 80, now, false, None, "", false);
+        assert!(
+            folded[0]
+                .to_string()
+                .starts_with("▸ ✓ resolved · 1 comment")
+        );
+    }
+}
